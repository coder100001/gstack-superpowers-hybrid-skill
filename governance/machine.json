    "RETRO": { "entry_gate": null },
    "ABORTED": { "entry_gate": null }
  },
  "transitions": [
    { "from": "IDEA", "to": "DISCOVERY" },
    { "from": "DISCOVERY", "to": "REQUIREMENT_LOCK" },
    { "from": "REQUIREMENT_LOCK", "to": "ARCH_REVIEW" },
